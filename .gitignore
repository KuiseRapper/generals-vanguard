# CMake build trees. build-perf/ is the -DPERF_TIMERS=ON measurement tree, which lives beside the
# shipping one so both exes can sit in Run/ at once (THREADING-ROADMAP.md section 0).
build/
build-perf/
build-fx/
# build-mac/ and build-linux/ are build-macos.sh's and build-linux.sh's trees (see PORTING.md).
build-mac/
build-linux/

# Build/test logs from the CMake port loop
*.log

# Python bytecode from Tools/
__pycache__/
*.pyc

# Per-machine overrides for build.bat and build-posix.sh, read after their defaults
build.local.bat
build.local.sh

CLAUDE.md
# AGENTS.md is deliberately NOT ignored in this fork: the working notes are committed so they travel
# with the repository. See AGENTS.md, "Deliberate deviations from upstream".

# graphify knowledge-graph output + extraction cache (derived, ~230 MB)
**/graphify-out/

# Layouts pulled out of WindowZH.big to feed Tools/optionsmenu_layout.py. That is game data and
# does not belong in the repo; re-extract it with Tools/bigfile.py when a layout has to be redone.
**/Tools/wnd/
build64/

# The Debug tree used for headless testing without a retail install (its _DEBUG builds the
# retail-install fingerprint out, at GameEngine.cpp:1353).  Kept apart from build-mac/ so the
# shipping Release tree and its measurements stay untouched.
build-mac-debug/

# .NET launcher build output
Tools/VanguardLauncher/bin/
Tools/VanguardLauncher/obj/
Tools/VanguardLauncher.Core/bin/
Tools/VanguardLauncher.Core/obj/
Tools/VanguardLauncher.Tests/bin/
Tools/VanguardLauncher.Tests/obj/

# macOS launcher build products
Tools/VanguardLauncherMac/build/
Tools/VanguardLauncherMac/.swift-cache/
Tools/VanguardLauncherMac/.tmp/

# Local .NET SDK used to build the launcher without touching the machine-wide install
.dotnet/
.dotnet-home/
.nuget/

# Release staging: launcher publish output, game zip, setup exe and manifest
dist/
